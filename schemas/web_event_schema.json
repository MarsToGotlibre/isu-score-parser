{
   "title" : "Web event JSON",
   "descritption" : "Data relative to a competition",
   "type" : "object",
   "properties":{
        "_extraction_metadata":{
            "description" : "Metadata related to the extraction",
            "type" : "object",
            "properties" :{
                "extraction_date":{
                    "type" : "string"
                },
                "scrapper_version":{
                    "description":"Version of the scrapper",
                    "type":"string"
                },
                "wayback_resolution" : {
                    "description" : "Links resolved py the wayback machine",
                    "type" : "object",
                    "paternProperties":{
                        ".+" :{
                            "description": "Relative link",
                            "type" : "object",
                            "properties" : {
                                "original" : {
                                    "description" : "Original full adress of the relative link",
                                    "type" : "string"
                                },
                                "resolved" : {
                                    "description":"Resolved archive link",
                                    "type" : "string"
                                },
                                "timestamp" : {
                                    "description" : "Timestamp of the archive",
                                    "type" : "string"
                                }
                            },
                            "required" : ["original","resolved","timestamp"]
                        }
                    }
                }
            }
        },
            
        "event_url":{
            "description" : "Main web page of the event",
            "type": "string"
        },
        "name" : {
            "description":"Name of the competition",
            "type" : "string"
        },
        "start_date" : {
            "type":"string"
        },
        "end_date" : {
            "type" : "string"
        },
        "timezone" :{
            "description" : "Timezone info",
            "type" : "object",
            "properties" : {
                "raw" : {
                    "description" : "Raw timezone offset parsed",
                    "type" : "string"
                },
                "offset":{
                    "description" : "Offset independetly of the standard",
                    "type" : "string"
                },
                "minutes" : {
                    "description" : "Minutes offset",
                    "type" :"integer"
                },
                "stardard" : {
                    "description" : "Timezone standart",
                    "type" : "string",
                    "enum" : ["GMT","UTC"]
                }
            }
        },
        "arena" : {
            "description" : "Arena where the event is being held",
            "type" : "string"
        },
        "location" : {
            "description" : "Place where the event is being held",
            "type": "object",
            "properties" : {
                "city":{
                    "type" : "string"
                },
                "country" : {
                    "description" : "alpha-3 country code",
                    "type" : "string",
                    "pattern" : "^[A-Z]{3}$"
                }
            }
        },
        "categories" :{
            "description" : "Disciplines/Categories competing in the event",
            "type" : "array",
            "items" :{
                "type" :"object",
                "properties" : {
                    "category" : {
                        "description" : "Disciplin/Category name",
                        "type" : "string"
                    },
                    "entries" : {
                        "description":"Team/sketers listed in the competition",
                        "type" : "array",
                        "items":{
                            "type" : "object",
                            "properties" :{
                                "number" : {
                                    "description" : "Number of the entry",
                                    "type" : "integer"
                                },
                                "name":{
                                    "description":"Team/skater name",
                                    "type":"string"
                                },
                                "nation" : {
                                    "description" : "alpha-3 country code",
                                    "type" : "string",
                                    "pattern" : "^[A-Z]{3}$"
                                },
                                "club":{
                                    "type":"string"
                                }
                            },
                            "required":["number","name","nation"],
                            "additionalProperties": false
                        }
                    },
                    "results" : {
                        "description" : "Final results details",
                        "type" :"array",
                        "items" :{
                            "type":"object",
                            "properties":{
                                "finalplace":{
                                    "description" : "Final place of the team/skater",
                                    "type" : "integer",
                                    "minimum" : 1
                                },
                                "name":{
                                    "description":"Team/skater name",
                                    "type":"string"
                                },
                                "club":{
                                    "type":"string"
                                },
                                "nation" : {
                                    "description" : "alpha-3 country code",
                                    "type" : "string",
                                    "pattern" : "^[A-Z]{3}$"
                                },
                                "totalpoints" : {
                                    "description" : "Total of points of all the segments",
                                    "type": "number",
                                    "minimum" :0
                                },
                                "places":{
                                    "description": "places obtained in each segment",
                                    "type" : "array",
                                    "items" : {
                                        "type" : "object",
                                        "properties":{
                                            "segment" : {
                                                "description" : "Segment skated",
                                                "type" : "string"
                                            },
                                            "place":{
                                                "description" : "Place obtained in the segment",
                                                "type" :"integer",
                                                "minimum" :1
                                            }
                                        },
                                        "required":["segment","place"]
                                    }
                                },
                                "status" : {
                                    "description" : "Status of the team/skater",
                                    "type" : "string",
                                    "enum" : ["RANKED","FINAL NOT REACHED","WITHDRAW"]
                                }
                            },
                            "required" : ["name","nation","status"]
                        }
                    },
                    "segment":{
                        "description":"Segments skated",
                        "type":"array",
                        "items":{
                            "type":"object",
                            "properties":{
                                "segment":{
                                    "description" : "Segment name",
                                    "type":"string"
                                },
                                "date":{
                                    "description" : "Date when the segment was skated",
                                    "type" : "string",
                                    "pattern" : "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                                },
                                "time":{
                                    "description" : "Time the segment started",
                                    "type" : "string",
                                    "pattern" : "^[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                                },
                                "panel":{
                                    "description":"Member of panel",
                                    "type": "array",
                                    "items":{
                                        "type":"object",
                                        "properties":{
                                            "nation" : {
                                                "description" : "Nation of the member of panel",
                                                "type":"string",
                                                "pattern":"^[A-Z]{3}$"
                                            },
                                            "function":{
                                                "description" : "Function occupied by the member of the panel",
                                                "type":"string"
                                            },
                                            "name":{
                                                "description" : "Identity of the member of panel",
                                                "type":"object",
                                                "properties":{
                                                    "first_name" : {
                                                        "type" :"string"
                                                    },
                                                    "last_name":{
                                                        "type":"string"
                                                    },
                                                    "gender" : {
                                                        "type":"string",
                                                        "enum" :["Women","Men"]
                                                    }
                                                },
                                                "required":["first_name","last_name","gender"]
                                            }
                                        },
                                        "required":["nation","function","name"]
                                    }
                                },
                                "detailed_results":{
                                    "description":"Detailed results for the segment",
                                    "type":"array",
                                    "items":{
                                        "type":"object",
                                        "properties":{
                                            "place":{
                                                "description":"Place obtained in the segment",
                                                "type":"integer",
                                                "minimum":1
                                            },
                                            "name":{
                                                "description":"Team/skater name",
                                                "type":"string"
                                            },
                                            "nation":{
                                                "description":"alpha-3 country code",
                                                "type":"string",
                                                "pattern":"^[A-Z]{3}$"
                                            },
                                            "tss":{
                                                "description" : "Total segment score",
                                                "type" : "number",
                                                "minimum":0
                                            },
                                            "tes":{
                                                "description":"Technical element score",
                                                "type" :"number",
                                                "minimum":0
                                            },
                                            "pcs":{
                                                "description":"Program componant score",
                                                "type" :"number",
                                                "minimum" : 0
                                            },
                                            "detailed_pcs":{
                                                "type":"array",
                                                "items":{
                                                    "type":"object",
                                                    "properties":{
                                                        "pcs":{
                                                            "description":"componant name",
                                                            "type":"string"
                                                        },
                                                        "score":{
                                                            "description" : "componant score",
                                                            "type":"number",
                                                            "minimum":0,
                                                            "maximum":10
                                                        }
                                                    },
                                                    "required":["pcs","score"]
                                                }
                                            },
                                            "deduction":{
                                                "type":"number",
                                                "maximum":0
                                            },
                                            "starting_number":{
                                                "type":"integer",
                                                "minimum":1
                                            },
                                            "club":{
                                                "type":"string"
                                            }
                                        },
                                        "additionalProperties":false
                                    }
                                },
                                "pdf_url":{
                                    "description":"url to the pdf with the detailed scores"
                                }
                            }
                        }
                    }
                },
                "required":["entries"],
                "additionalProperties": false
            }
        }
    }
}